# Runtime
NODE_ENV=development
PORT=8787
LOG_LEVEL=info
WR_DEFAULT_LOCALE=en-US
WR_PUBLIC_BASE_URL=http://localhost:8787

# Required for durable mode / Prisma
DATABASE_URL=postgresql://wrenchrelay:change-me@localhost:5432/wrenchrelay?schema=public

# Production gateway authentication. Generate 32+ random bytes.
WR_GATEWAY_HMAC_SECRET=replace-with-a-long-random-secret

# In development only, permits local requests without gateway signatures.
WR_ALLOW_UNSIGNED_DEV=true

# Optional CMMS provider secrets are referenced by tenant configuration.
# Example secretRef "fiix_primary" resolves to WR_SECRET_FIIX_PRIMARY.
# Do not commit real credentials.
WR_SECRET_FIIX_PRIMARY=
WR_SECRET_EMAINT_PRIMARY=
WR_SECRET_MAINTENANCE_CONNECTION_PRIMARY=
