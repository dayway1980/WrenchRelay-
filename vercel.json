{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web/"
    },
    "api": {
      "root": "api-service/",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/__bridge/railway-health",
      "destination": "https://wrenchrelay-app-production.up.railway.app/api/health"
    },
    {
      "source": "/__bridge/railway-openapi",
      "destination": "https://wrenchrelay-app-production.up.railway.app/openapi.json"
    },
    {
      "source": "/api",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
