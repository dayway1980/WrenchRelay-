# Disposable, access-gated Rivit inbound candidate. Never deploy to public
# customer WrenchRelay services or merge this QA-specific file to main.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 WR_ISOLATED_QA=true
WORKDIR /srv/rivit-qa
COPY api-service/requirements.txt ./requirements.txt
RUN python -m pip install --no-cache-dir --disable-pip-version-check -r requirements.txt
COPY api-service/ ./
RUN python -m py_compile main.py twilio_voice.py
RUN useradd -r -u 10001 -g nogroup rivitqa && chown -R rivitqa:nogroup /srv/rivit-qa
USER rivitqa
EXPOSE 8080
CMD ["sh", "-c", "exec uvicorn main:app --host 0.0.0.0 --port ${PORT:-8080}"]
